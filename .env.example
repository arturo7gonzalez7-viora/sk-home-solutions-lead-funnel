# Funnel database (Neon) — leads, consent, and AI call results
DATABASE_URL=postgres://user:password@your-neon-host.neon.tech/neondb?sslmode=require

# Password for the private /leads dashboard
ADMIN_PASSWORD=

# Retell AI — instant call to leads who check the call box
RETELL_API_KEY=          # the key with the "webhook" badge (also verifies webhooks)
RETELL_FROM_NUMBER=      # your Retell number, E.164, e.g. +17205551234
RETELL_AGENT_ID=         # optional; agent_... to use for these calls

# Steven's CRM (steven-crm.vercel.app) — its Neon database
CRM_DATABASE_URL=
CRM_ASSIGN_TO=           # optional CRM user id for new leads, e.g. u_steven
